;; meta-signal-router — POLICY (meta) wire contract for the PersonaRouter
;; channel-authority surface.
;;
;; Wire-only: emits the rkyv + NOTA codec and the signal-frame mail
;; envelope (Input/Output enums, route witnesses, short headers, and
;; encode/decode_signal_frame). No engine traits, no Nexus/SEMA content,
;; no daemon behaviour — runtime actors, policy evaluation, socket
;; binding, and durable grant tables live in the router daemon.
;;
;; This is the meta policy signal leg of the router component triad
;; (router daemon + signal-router working signal + meta-signal-router).
;; The caller is orchestrate, because Orchestrate owns Router in
;; the authority graph. Mind decides whether channel policy should change,
;; orders Orchestrate through meta-signal-orchestrate, and Orchestrate
;; enacts that decision here. Ordinary router observation traffic stays in
;; signal-router.
;;
;; SHARED ROUTER TYPES. ChannelIdentifier and TimestampNanoseconds are
;; imported from the ordinary signal-router contract so meta orders and
;; router observations speak the same daemon-minted channel identity and
;; timestamp vocabulary.
;;
;; LOCAL POLICY VOCABULARY. The upstream signal-persona-origin contract
;; is not yet an emitting wire contract, so this schema defines the policy
;; vocabulary it needs (ChannelEndpoint, ComponentName, ConnectionClass,
;; ChannelDuration, ChannelMessageKind) LOCALLY. When signal-persona-origin
;; becomes an emitting contract, these can migrate to cross-imports via the
;; signal-persona-origin:lib:TypeName form (precedent: meta-signal-lojix
;; cross-importing signal-lojix:lib types).
;;
;; OPERATION VOCABULARY. The four channel-authority meta operations mirror
;; the established router channel-authority surface exactly:
;;   Grant   apply meta authority by creating or replacing a live grant;
;;   Extend  change the duration of a live channel grant;
;;   Revoke  remove a live channel grant;
;;   Deny    record a meta-policy decision that an adjudication request will
;;           not receive a grant.
;; A fifth operation gates the router's mirror path (primary-nbmq.7, piece 6
;; of the persistent Spirit-mirror design):
;;   SetMirrorEnabled  flip the router's single, owner-only, persisted
;;                     mirror switch. Default OFF; the value survives a
;;                     router restart. While OFF the router neither
;;                     originates nor accepts mirror (routed-object)
;;                     forwards — the router is the single network
;;                     chokepoint, so this one gate is authoritative
;;                     regardless of Spirit/Criome state.
;; The wire carries contract-local operation roots only — there is no
;; public Mutate or Retract wrapper; the Sema class is a daemon-side
;; projection.
;;
;; META-ORDER NAMES ARE NOT MESSAGE KINDS. Grant / extension / revocation /
;; denial are operations on THIS contract, not categories of message routed
;; through ordinary channels, so the ChannelMessageKind enum names none of
;; them.

{
  ChannelIdentifier signal-router:lib:ChannelIdentifier
  TimestampNanoseconds signal-router:lib:TimestampNanos
}
[Grant Extend Revoke Deny SetMirrorEnabled]
[ChannelGranted ChannelExtended ChannelRevoked AdjudicationDenied ChannelOrderRejected RequestUnimplemented MirrorEnabledSet]
{
  Grant ChannelGrant
  Extend ChannelExtension
  Revoke ChannelRevocation
  Deny AdjudicationDenial
  SetMirrorEnabled MirrorEnabled

  ChannelGranted GrantedChannel
  ChannelExtended ExtendedChannel
  ChannelRevoked RevokedChannel
  AdjudicationDenied DeniedAdjudication
  ChannelOrderRejected RejectedChannelOrder
  RequestUnimplemented UnimplementedRequest
  MirrorEnabledSet MirrorEnabled

  ;; The identifier a live channel is known by. Daemon-minted on Grant and
  ;; carried back in the GrantedChannel reply; callers reference an existing
  ;; one on Extend / Revoke. Imported from signal-router, never caller-
  ;; supplied at create.

  ;; The identifier of an adjudication request that meta policy declines.
  AdjudicationRequestIdentifier String

  ;; Free text carried on a revocation or denial reason.
  TextBody String

  ;; A wall-clock instant in nanoseconds, used by a time-bound grant. This
  ;; aliases signal-router's TimestampNanos type.

  ;; Whether the router's mirror path is switched on. Carried both as the
  ;; requested value on SetMirrorEnabled and as the confirmed value on
  ;; MirrorEnabledSet — the toggle always applies (owner-only, no policy
  ;; check), so the reply simply echoes what is now in effect.
  MirrorEnabled Boolean

  ;; A supervised component instance inside the local Persona engine,
  ;; mirrored from signal-persona-origin's ComponentName.
  ComponentName [Mind Message Router Terminal Harness System Introspect Orchestrate Spirit]

  ;; The connection trust class after ingress has crossed the operating-
  ;; system boundary, mirrored from signal-persona-origin's ConnectionClass.
  ;; The Unix uid is carried as u64 — the NOTA text codec implements its
  ;; integer trait for u64 only, and a uid fits without loss.
  UnixUserIdentifier Integer
  SystemPrincipal String
  EngineIdentifier String
  HostName String
  NetworkPeer String
  Host HostName
  OtherPersonaEngine { EngineIdentifier Host }
  ConnectionClass [Owner (NonOwnerUser UnixUserIdentifier) (System SystemPrincipal) (OtherPersona OtherPersonaEngine) (Network NetworkPeer)]

  ;; A channel endpoint is either an internal component or an external
  ;; connection class.
  ChannelEndpoint [(Internal ComponentName) (External ConnectionClass)]

  ;; The route categories a grant can cover. Meta-order names (grant,
  ;; extension, revocation, denial) are deliberately absent — those are
  ;; operations on this contract, not routed message kinds.
  ChannelMessageKind [
    MessageIngressSubmission
    MessageSubmission
    InboxQuery
    FocusObservation
    PromptBufferObservation
    MessageDelivery
    TerminalInput
    TerminalCapture
    TerminalResize
    TranscriptEvent
    AdjudicationRequest
    DeliveryNotification
  ]

  ;; The requested lifetime of a grant: one-shot, permanent, or bounded by
  ;; a wall-clock instant.
  ChannelDuration [OneShot Permanent (TimeBound TimestampNanoseconds)]
  Kinds (Vector ChannelMessageKind)
  Duration ChannelDuration
  Channel ChannelIdentifier
  Reason TextBody
  DeniedRequest AdjudicationRequestIdentifier

  ;; Grant payload — the source/destination endpoints, the covered route
  ;; categories, and the requested duration.
  ChannelGrant {
    source.ChannelEndpoint
    destination.ChannelEndpoint
    Kinds
    Duration
  }

  ;; Extend payload — change the duration of an existing live channel.
  ChannelExtension { Channel Duration }

  ;; Revoke payload — remove a live channel, with a reason for the record.
  ChannelRevocation { Channel Reason }

  ;; Deny payload — close an adjudication request without a grant.
  AdjudicationDenial { DeniedRequest Reason }

  ;; Reply payloads.
  GrantedChannel ChannelIdentifier
  ExtendedChannel ChannelIdentifier
  RevokedChannel ChannelIdentifier
  DeniedAdjudication AdjudicationRequestIdentifier

  ;; Which operation a rejection or unimplemented reply refers back to.
  OperationKind [Grant Extend Revoke Deny]
  Operation OperationKind

  ;; The order was understood but rejected by router policy.
  ChannelOrderRejectionReason [MetaAuthorityRequired ChannelAlreadyExists ChannelMissing AdjudicationRequestMissing PolicyRefused]
  OrderRejectionReason ChannelOrderRejectionReason
  RejectedChannelOrder { Operation OrderRejectionReason }

  ;; The request is in the contract but not implemented by the current
  ;; runtime.
  UnimplementedReason [NotBuiltYet DependencyNotReady PolicyStoreUnavailable]
  ImplementationReason UnimplementedReason
  UnimplementedRequest { Operation ImplementationReason }
}
