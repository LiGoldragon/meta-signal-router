Grant.{ External.NonOwnerUser.1001 Internal.Router [] OneShot }
Grant.{ External.OtherPersona.{ engine-2 goldragon } Internal.Router [] OneShot }
Grant.{ External.Owner Internal.Router [] OneShot }

ChannelOrderRejected.{ Deny MetaAuthorityRequired }
